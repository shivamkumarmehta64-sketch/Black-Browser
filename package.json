{
  "name": "black-noir",
  "version": "1.0.0",
  "description": "Minimal Windows WebView2 browser with native adblock-rust engine",
  "author": "shivamkumarmehta64-sketch",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist-portable": "electron-builder --win portable",
    "dist-all": "electron-builder --win nsis --win portable",
    "dist-linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.blacknoir.browser",
    "productName": "Black Noir",
    "win": {
      "target": ["nsis", "portable"],
      "sign": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": { "target": ["AppImage"], "category": "Network" },
    "extraResources": [{ "from": "ublock/uBlock0.chromium", "to": "ublock" }]
  }
}
